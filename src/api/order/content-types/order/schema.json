{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "sequenceNumber": {
      "type": "integer",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "orders"
    },
    "salesRep": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sales-rep.sales-rep",
      "inversedBy": "orders"
    },
    "recipientName": {
      "type": "string",
      "required": true
    },
    "recipientPhone": {
      "type": "string",
      "required": true
    },
    "remittance": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "total": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "paymentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "pending",
      "enum": [
        "paid",
        "pending"
      ]
    },
    "cancelled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "orderItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "bankAccount": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bank-account.bank-account",
      "inversedBy": "orders"
    }
  }
}
